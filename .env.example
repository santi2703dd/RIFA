# Copia este archivo a .env para probar en tu PC. En Render estas mismas variables van en "Environment".
PORT=3000
NODE_ENV=development

# Cadena de conexión de CockroachDB (la misma del otro proyecto sirve: las tablas se llaman rifa_*)
DATABASE_URL=postgresql://usuario:clave@host:26257/defaultdb?sslmode=verify-full

# Clave del organizador (para confirmar pagos, ver comprobantes y editar puestos)
ADMIN_CLAVE=pon-aqui-una-clave-larga
# Cadena larga y aleatoria para firmar la sesión del organizador
SESSION_SECRET=otra-frase-larga-y-rara

# Textos opcionales que se muestran en la página
FECHA_SORTEO=Sábado 24 de octubre
LUGAR_HORA=
CONTACTO=WhatsApp 300 000 0000
DATOS_PAGO=Nequi 300 000 0000 a nombre de ...
